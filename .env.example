# LifeWise AI Environment Configuration
DATABASE_URL="file:./dev.db"

# Port configurations
PORT=3000
MCP_PORT=3001

# Optional AI LLM Provider Configuration (Gemini or OpenAI API key)
# If left empty, LifeWise AI automatically uses its robust, deterministic rule-based assistant
AI_PROVIDER="rule_based" # "gemini", "openai", or "rule_based"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Hackathon Alexa+ Settings
ALEXA_MCP_TRANSPORT="http" # "http" (streamable SSE/HTTP) or "stdio"
